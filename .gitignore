# ==============================================================================
# Git Ignore - MALEMI Web (Next.js + TypeScript + Tailwind CSS)
# ==============================================================================

# Dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testes e Cobertura
/coverage

# Next.js Build e Export
/.next/
/out/
/build
/dist

# Logs de depuração
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variáveis de Ambiente (bloqueia credenciais e permite .env.example)
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Arquivos de IDEs e Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Certificados e Chaves
*.pem
*.key
*.cert

# Diretórios temporários ou de suporte
malemi-web/
*meu_git.txt
